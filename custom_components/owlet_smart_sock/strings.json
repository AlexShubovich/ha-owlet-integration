      "heart_rate": { "name": "Heart rate" },
      "oxygen_saturation": { "name": "Oxygen saturation" },
      "movement": { "name": "Movement" },
      "skin_temperature": { "name": "Skin temperature" },
      "battery_time_remaining": { "name": "Battery time remaining" },
      "wifi_signal": { "name": "Wi-Fi signal" },
